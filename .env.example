# Environment variables for OA Assistant
# Copy this file to .env and fill in the values

# Application
APP_NAME=OA Assistant
VERSION=0.1.0
DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=oa_assistant.log

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OCR Provider
OCR_PROVIDER=tesseract
TESSERACT_CMD=/usr/local/bin/tesseract  # Update to your tesseract path

# Screen Capture
SCREEN_CAPTURE_PROVIDER=mss

# Hotkeys
HOTKEY_TOGGLE_OVERLAY=ctrl+alt+o
HOTKEY_CAPTURE_REGION=ctrl+alt+c

# Overlay settings
OVERLAY_OPACITY=0.9
OVERLAY_WIDTH=400
OVERLAY_HEIGHT=500